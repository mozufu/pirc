<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <!-- Debug builds only: drives the quick-reply overlay into one state with fake
             data, for screenshots (DebugOverlayReceiver). Only the shell may send to it
             (it holds DUMP). The scene is a string extra; see the receiver for the
             command line and the scenes. -->
        <receiver
            android:name=".overlay.DebugOverlayReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="org.mozufu.pirc.debug.OVERLAY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
