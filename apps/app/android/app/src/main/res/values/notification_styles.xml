<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One choice button of the expanded question notification (layout/notification_question.xml). -->
    <style name="NotificationChoice">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:background">@drawable/notification_choice</item>
        <item name="android:textAppearance">@android:style/TextAppearance.Material.Notification.Title</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
