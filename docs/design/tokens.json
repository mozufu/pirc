      "text.warning": "#E7B369",
      "status.danger": "#E2726B",
      "status.dangerSoft": "rgba(226,114,107,0.14)",
      "code.bg": "#1E1E20",
      "code.text": "#E1E4E8",
      "scrim": "rgba(0,0,0,0.50)",
      "action.primary": "#F9FAFB",
      "action.onPrimary": "#151517",
      "avatar.1": "#8EA3CC",
