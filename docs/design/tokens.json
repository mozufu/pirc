    "terminal": {
      "$note": "Terminal is always dark, independent of app theme.",
      "bg": "#101216",
      "bar.border": "rgba(255,255,255,0.06)",
      "text": "#D9DEE6",
      "dim": "#7F8896",
      "green": "#7FCB9C",
      "red": "#F0958C",
      "yellow": "#E7C07A",
      "blue": "#8FB3F0",
      "cursor": "#D9DEE6",
      "keys.bg": "#16191E",
      "key": "#23272E",
      "key.text": "#E3E6EB"
    },
    "$note_avatar": "avatar.* is identity only (never status, never chart categories: adjacent pairs fail colour-vision separation). status.working = success hue, used only for the \"工作中\" pill."
  },
  "typography": {
    "family.ui": [
      "system (Roboto / SF Pro)",
      "Noto Sans TC / PingFang TC"
    ],
    "family.mono": [
      "JetBrains Mono",
      "SF Mono",
      "monospace"
    ],
    "$rule": "CJK body and list text use weight 400. 500 only for buttons and action items; 600 for titles.",
    "display": {
      "size": 24,
      "lineHeight": 32,
      "weight": 600
    },
    "title.sheet": {
      "size": 20,
      "lineHeight": 28,
      "weight": 600
    },
    "title.card": {
      "size": 17,
      "lineHeight": 24,
      "weight": 600
    },
    "title.bar": {
      "size": 16,
      "lineHeight": 22,
      "weight": 600
    },
    "body.reading": {
      "size": 16,
      "lineHeight": 28,
      "weight": 400
    },
    "body.reader": {
      "size": 16.5,
      "lineHeight": 29,
      "weight": 400
    },
    "row": {
      "size": 15,
      "lineHeight": 22,
      "weight": 400
    },
    "button": {
      "size": 15,
      "lineHeight": 20,
      "weight": 500
    },
    "secondary": {
      "size": 13,
      "lineHeight": 18,
      "weight": 400,
      "color": "text.muted"
    },
    "label.section": {
      "size": 12.5,
      "lineHeight": 18,
      "weight": 600,
      "letterSpacing": 0.5,
      "color": "text.muted"
    },
    "caption": {
      "size": 12.5,
      "lineHeight": 18,
      "weight": 400,
      "color": "text.muted"
    },
    "mono.code": {
      "size": 13,
      "lineHeight": 20
    },
    "mono.terminal": {
      "size": 12.5,
      "lineHeight": 18
    }
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "panel": 28,
    "pill": 999,
    "device.tablet": 24
  },
  "spacing": {
    "gutter.phone": 16,
    "gutter.drawerText": 24,
    "gutter.groupedText": 32,
    "composer.sideInset": 12,
    "stack.xs": 4,
    "stack.sm": 8,
    "stack.md": 12,
    "stack.lg": 16,
    "stack.xl": 24
  },
  "elevation": {
    "$rule": "One separation treatment per surface. Floating = shadow only; raised card = shadow only (dark: fill only); grouped = fill only; lines only for tables, list separators, pane dividers.",
    "card": {
      "light": "0 1 2 rgba(15,17,21,.04), 0 6 20 rgba(15,17,21,.06)",
      "dark": "none (rely on surface.layer)"
    },
    "float": {
      "light": "0 2 8 rgba(15,17,21,.05), 0 10 32 rgba(15,17,21,.09)",
      "dark": "0 8 28 rgba(0,0,0,.45)"
    },
    "floatFocus": {
      "light": "0 2 8 rgba(15,17,21,.07), 0 12 36 rgba(15,17,21,.12)",
      "dark": "0 8 32 rgba(0,0,0,.55)"
    },
    "pop": {
      "light": "0 -2 12 rgba(15,17,21,.06), 0 -12 40 rgba(15,17,21,.12)",
      "dark": "0 -8 32 rgba(0,0,0,.5)"
    }
  },
  "size": {
    "touchTarget.min": 44,
    "touchTarget.preferred": 48,
    "topBar": 56,
    "icon.bar": 22,
    "icon.row": 18,
    "icon.inline": 16,
    "icon.stroke": 1.75,
    "composer.minHeight": 104,
    "composer.button": 40,
    "drawer.width": 318,
    "tablet.sidebar": 280,
    "reading.maxWidth": 680,
    "stateDot": 7,
    "avatar.sm": 28,
    "avatar.md": 36,
    "avatar.default": 48,
    "avatar.lg": 88,
    "statusPill.height": 16,
    "statusPill.heightMd": 14,
    "tabBar.height": 56,
    "rail.width": 72
  },
  "layout": {
    "$note": "Decide by available window width, not device type. Preserve conversation, scroll, draft and side-panel content when the layout changes.",
    "compact": {
      "maxWidth": 599,
      "structure": "single screen + bottom tab bar 56; drawer 310 pushes the page"
    },
    "portrait": {
      "minWidth": 600,
      "maxWidth": 899,
      "structure": "tab rail 76 + one pane (list OR content, back to list); info panels slide over from the right, width 440"
    },
    "landscape": {
      "minWidth": 900,
      "maxWidth": 1199,
      "structure": "tab rail 76 + list 320 + content; side-panel content replaces the content pane; drawer 396"
    },
    "desktop": {
      "minWidth": 1200,
      "structure": "tab rail 72 + list 340 + content + optional side panel 400; conversation max width 760, settings pages 720; drawer 412"
    }
  },
  "motion": {
    "ease": "cubic-bezier(0.4, 0, 0.2, 1)",
    "fast": 150,
    "sheet": 250,
    "reduceMotion": "disable pulse/spinner loops; keep instant state changes"
  }
}