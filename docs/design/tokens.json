{
  "$meta": {
    "name": "pirc app · directions C/D/E",
    "version": "0.3.0",
    "source": "apps/web/src/app.css @ c4b7dd3, adjusted (see $changedFromWeb)",
    "usage": "Semantic names are the contract. Map each group to a Flutter ThemeExtension; never reference raw hex in widgets.",
    "$changedFromWeb": [
      "accent #4176E6 -> #4B6BA6 (desaturated, 5.3:1 on white)",
      "status hues desaturated to match accent chroma",
      "NEW: text.warning / text.success (status colours as text need >= 4.5:1)",
      "NEW: surface.grouped (settings ground once rings were removed)",
      "shadows split into card / float / pop; ring removed from shadows",
      "E: avatar identity palette, working-status green pill, desktop/tablet-portrait layout sizes"
    ]
  },
  "color": {
    "light": {
      "surface.page": "#FFFFFF",
      "surface.sidebar": "#F9FAFB",
      "surface.layer": "#FFFFFF",
      "surface.subtle": "#F1F3F5",
      "surface.grouped": "#EFF1F4",
      "surface.bubble": "#EDF3FE",
      "surface.input": "#FFFFFF",
      "fill.hover": "rgba(38,49,72,0.06)",
      "fill.hoverStrong": "rgba(38,49,72,0.10)",
      "fill.active": "rgba(38,49,72,0.08)",
      "text.primary": "#0F1115",
      "text.secondary": "#61666B",
      "text.muted": "#6E7278",
      "text.faint": "#ADB2B8",
      "line.hairline": "rgba(0,0,0,0.06)",
      "line.default": "rgba(0,0,0,0.12)",
      "line.strong": "rgba(0,0,0,0.16)",
      "accent.default": "#4B6BA6",
      "accent.pressed": "#3F5E96",
      "accent.soft": "#EEF2F9",
      "accent.onSoft": "#1E3256",
      "accent.on": "#FFFFFF",
      "status.success": "#308E63",
      "text.success": "#216A49",
      "status.warning": "#D09033",
      "status.warningSoft": "#FAF3E7",
      "text.warning": "#7D4F1B",
      "status.danger": "#C0453D",
      "status.dangerSoft": "#FBEDEB",
      "code.bg": "#F6F7F9",
      "code.text": "#24292F",
      "scrim": "rgba(15,17,21,0.32)",
      "action.primary": "#0F1115",
      "action.onPrimary": "#FFFFFF",
      "avatar.1": "#5A6E93",
      "avatar.2": "#4D8174",
      "avatar.3": "#A26A55",
      "avatar.4": "#7C6690",
      "avatar.5": "#7A7650",
      "avatar.ink": "#FFFFFF",
      "status.working": "#308E63",
      "status.workingDot": "#FFFFFF"
    },
    "dark": {
      "surface.page": "#151517",
      "surface.sidebar": "#1C1C1E",
      "surface.layer": "#232324",
      "surface.subtle": "#2C2C2E",
      "surface.grouped": "#111113",
      "surface.bubble": "#2C2C2E",
      "surface.input": "#232324",
      "fill.hover": "rgba(255,255,255,0.08)",
      "fill.hoverStrong": "rgba(255,255,255,0.12)",
      "fill.active": "rgba(255,255,255,0.10)",
      "text.primary": "#F9FAFB",
      "text.secondary": "#C8CCD2",
      "text.muted": "#969AA0",
      "text.faint": "#64686E",
      "line.hairline": "rgba(255,255,255,0.06)",
      "line.default": "rgba(255,255,255,0.12)",
      "line.strong": "rgba(255,255,255,0.20)",
      "accent.default": "#88ABEA",
      "accent.pressed": "#A3BFF0",
      "accent.soft": "rgba(136,171,234,0.14)",
      "accent.onSoft": "#BCD0F5",
      "accent.on": "#10182A",
      "status.success": "#66C093",
      "text.success": "#66C093",
      "status.warning": "#E7B369",
